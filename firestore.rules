rules_version = '2';
// GrowthGrid CRM — Firestore security rules (multi-tenant)
//
// Har company ka data `tenants/{t}/...` ke neeche. User ki company + role Auth custom-claims se aate hain
// (`request.auth.token.tid` / `.role`) — Cloud Function (Admin SDK) set karta hai, client badal nahi sakta.
//
// Company ka state (tenants/{t} doc) rules mein enforce hota hai — lib/tenantState.js ka mirror:
//   readable()  : status != 'cancelled'                      (cancelled = login/read band)
//   writable()  : status in ['active','trial'] && request.time < access_until
//                 (access_until = paid_until + grace_days; suspended/expired => sirf VIEW)
// Client se `tenants/{t}` doc, `tenant_slugs`, `plans`, `superadmins` kabhi write nahi hote — sirf Cloud Functions.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSA() { return isSignedIn() && request.auth.token.get('sa', false) == true; }

    // ---- public / super-admin level ----
    match /tenant_slugs/{slug} {
      allow read: if true;            // login page company ka naam dikhata hai (koi secret nahi rakhna is doc mein)
      allow write: if false;
    }
    match /plans/{id} {
      allow read: if isSA();
      allow write: if false;
    }
    match /superadmins/{uid} {
      allow read: if isSA();
      allow write: if false;
    }

    match /tenants/{t} {

      function inTenant()   { return isSignedIn() && request.auth.token.get('tid', '') == t; }
      function tenantData() { return get(/databases/$(database)/documents/tenants/$(t)).data; }
      function readable()   { return tenantData().status != 'cancelled'; }
      function writable() {
        return tenantData().status in ['active', 'trial']
          && (tenantData().get('access_until', null) == null || request.time < tenantData().access_until);
      }
      // read-side "provisioned"; write-side rules mein writable() alag se lagta hai
      function isProvisioned() { return inTenant() && readable(); }
      function canWrite()      { return inTenant() && writable(); }
      function role()          { return request.auth.token.get('role', ''); }
      function isAdmin()       { return isProvisioned() && role() == 'admin'; }
      // md = Managing Director, tl = Team Leader. Poora business-data DEKHNE + leads pe ACT karne milta hai,
      // par technical control (settings/users/builders/recycle) sirf admin ka.
      function isOversight()   { return isProvisioned() && role() in ['admin', 'md', 'tl']; }
      function adminW()        { return canWrite() && role() == 'admin'; }
      function oversightW()    { return canWrite() && role() in ['admin', 'md', 'tl']; }

      allow read: if inTenant() || isSA();
      allow write: if false;

      // Super admin ka billing ledger — company ko nahi dikhta
      match /payments/{id} {
        allow read: if isSA();
        allow write: if false;
      }

      match /users/{uid} {
        allow read: if isProvisioned();
        // user create/delete/role badalna = Cloud Function (license limit + claims). Client sirf apne chhote fields.
        allow create, delete: if false;
        allow update: if canWrite() && (
             (role() == 'admin' && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['role', 'status', 'email', 'login_id', 'tid']))
          || (request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['attendance', 'fcm_tokens', 'last_login', 'last_seen', 'last_worked_at', 'must_reset_password', 'updated_at', 'lang'])));
      }

      match /leads/{id} {
        allow read: if isOversight()
          || (isProvisioned() && role() == 'ldr'   && (resource.data.ldr_uid == request.auth.uid
                                    || resource.data.status in ['fresh', 'new']))
          || (isProvisioned() && role() == 'sales' && resource.data.sales_uid == request.auth.uid);
        allow create: if canWrite();
        // owner / admin / md / tl -> full update.  koi bhi signed-in -> sirf re-inquiry / resurrect fields.
        // LDR kabhi `sales_status` nahi likh sakta (Sales-stage galti se set na ho) — Sales `status` nahi.
        // status / sales_status ko khaali ('') set karna kabhi allowed nahi — "other" bucket isse aata tha
        allow update: if canWrite() && (
             (
                 role() in ['admin', 'md', 'tl']
              || (role() == 'ldr'   && (resource.data.ldr_uid == request.auth.uid
                                        || resource.data.status in ['fresh', 'new'])
                                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sales_status']))
              || (role() == 'sales' && resource.data.sales_uid == request.auth.uid
                                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'ldr_uid']))
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                    ['is_urgent', 'urgent_at', 'reinq_open', 'next_followup', 'updated_at',
                     'last_action_at', 'last_action_by', 'last_action_by_name',
                     'sla_fresh_alerted', 'sla_followup_alerted', 'sla_followup_due_alerted',
                     'sla_contact_alerted', 'sla_sales_alerted',
                     'archived', 'archived_at', 'reinq_after_archive', 'reinq_after_archive_at', 'reinq_after_archive_count',
                     'status', 'sales_status', 'outcome', 'closed_at', 'sales_open']))
              // Archived lead ko koi bhi user "dobara enquiry" ke roop me wapas la sakta hai
              || (resource.data.get('archived', false) == true
                  && request.resource.data.archived == false
                  && request.resource.data.reinq_after_archive == true)
              // Re-inquiry pe re-assign — is_urgent (re)set hona zaroori — normal edit nahi.
              || (request.resource.data.is_urgent == true
                  && request.resource.data.urgent_at != resource.data.get('urgent_at', null)
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                      ['is_urgent', 'urgent_at', 'reinq_open', 'next_followup', 'updated_at',
                       'last_action_at', 'last_action_by', 'last_action_by_name',
                       'sla_fresh_alerted', 'sla_followup_alerted', 'sla_followup_due_alerted',
                       'sla_contact_alerted', 'sla_sales_alerted',
                       'archived', 'archived_at', 'reinq_after_archive', 'reinq_after_archive_at', 'reinq_after_archive_count',
                       'status', 'sales_status', 'outcome', 'closed_at', 'sales_open',
                       'ldr_uid', 'ldr_name', 'sales_uid', 'sales_name', 'assigned_sales_at']))
             )
          && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) && request.resource.data.status == '')
          && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['sales_status']) && request.resource.data.sales_status == '')
        );
        allow delete: if adminW();
      }

      match /phone_index/{digits} {
        allow read:  if isProvisioned();
        allow write: if canWrite();   // lead create / phone-edit ke saath sync
      }

      match /activity/{id} {
        allow read:   if isProvisioned();
        allow create: if canWrite();
        allow update, delete: if false;
      }

      match /orders/{id} {
        allow read:  if isProvisioned();
        allow write: if canWrite() && role() in ['admin', 'sales'];
      }

      match /stats_daily/{id}    { allow read: if isOversight(); allow write: if false; }
      match /stats_cohort/{id}   { allow read: if isOversight(); allow write: if false; }
      match /reports_weekly/{id} { allow read: if isOversight(); allow write: if false; }

      // Email App Password jaisa secret — kabhi kisi ko (admin ko bhi) wapas nahi padha jaata,
      // sirf overwrite ho sakta hai. Cloud Functions Admin SDK se seedha padh leti hain (rules bypass).
      match /config/mail_secret {
        allow read:  if false;
        allow write: if adminW();
      }

      // ad_spend — dashboard ke ROI report ke liye md/tl ko bhi padhna hai
      match /config/ad_spend {
        allow read:  if isOversight();
        allow write: if adminW();
      }

      // Sirf ye config docs sab users padh sakte hain (stages/forms LDR-Sales ko chahiye).
      // mail_secret / ai_secret is rule se match NAHI hote (id list mein nahi).
      match /config/{id} {
        allow read:  if isProvisioned() && id in ['stages', 'forms', 'settings', 'access'];
        allow write: if adminW();
      }

      match /logs/{id} {
        allow read:   if isAdmin();
        allow create: if canWrite();
        allow update, delete: if false;
      }

      match /audit/{id} {
        allow read:   if isAdmin() || (isProvisioned() && role() == 'md');
        allow create: if canWrite();
        allow update, delete: if false;
      }

      match /recycle/{id} {
        allow read:  if isAdmin();
        allow write: if adminW();
      }

      match /admin_tasks/{id} {
        allow read:  if isAdmin();
        allow write: if adminW();   // function server-side merge karta hai (rules bypass)
      }

      match /notifications/{id} {
        allow read: if isProvisioned() && resource.data.to_uid == request.auth.uid;
        allow update: if canWrite() && resource.data.to_uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        // owner apni notification list se item hata (dismiss) sakta hai; banata sirf Cloud Function
        allow delete: if canWrite() && resource.data.to_uid == request.auth.uid;
        allow create: if false;
      }

      match /meta/{id} {
        allow read:  if isProvisioned();
        allow write: if canWrite();   // lead-id counter — koi bhi user naya lead bana sakta hai
      }

      // Help — Ask-AI. User apna sawaal likhta hai (status:'pending'), function jawab bharta hai (Admin SDK).
      match /help_queries/{id} {
        allow read:   if isProvisioned() && (request.auth.uid == resource.data.by_uid || role() == 'admin');
        allow create: if canWrite()
                      && request.resource.data.by_uid == request.auth.uid
                      && request.resource.data.status == 'pending';
        // sirf owner apna feedback add kar sakta hai — answer/status function likhta hai
        allow update: if canWrite() && request.auth.uid == resource.data.by_uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['helpful', 'feedback_note', 'feedback_at', 'ticket_id']);
        allow delete: if false;
      }

      // Knowledge base — AI ki "training". Admin manage karta hai; function (Admin SDK) padhta/likhta hai.
      match /help_kb/{id} {
        allow read:  if isAdmin();
        allow write: if adminW();
      }

      // Support tickets — owner banata + dekhta hai; sirf admin status/notes badalta hai.
      match /tickets/{id} {
        allow read:   if isProvisioned() && (request.auth.uid == resource.data.by_uid || role() == 'admin');
        allow create: if canWrite()
                      && request.resource.data.by_uid == request.auth.uid
                      && request.resource.data.status == 'open';
        allow update, delete: if adminW();
      }

      // AI API key (company ki apni, agar di ho) — kabhi read nahi, sirf admin overwrite
      match /config/ai_secret {
        allow read:  if false;
        allow write: if adminW();
      }
    }
  }
}
